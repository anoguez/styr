{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Styr remote protocol",
  "description": "Generated by src/server/protocolSchema.ts; do not edit. See docs/architecture/remote-access.md.",
  "protocol": 1,
  "transport": {
    "url": "ws://<host>:<port>/",
    "relayUrl": "ws://<relay>:<port, 7879>/phone/<host fingerprint>",
    "frames": "text frames only: the handshake (below), then each one a sealed Noise record of a JSON-RPC 2.0 message",
    "maxRecordFrameChars": 87380,
    "handshakeMaxBytes": 2048,
    "handshakeTimeoutMs": 10000,
    "maxFrameBytes": 8388608,
    "closeCodes": {
      "4400": "bad request (binary frame, a frame that fails to decrypt)",
      "4401": "unauthorized (every handshake failure)",
      "4403": "the device was revoked",
      "4408": "handshake timeout",
      "4429": "too many attempts"
    },
    "jsonRpcErrors": {
      "-32001": "forbidden: the call is not open to remote devices"
    }
  },
  "handshake": {
    "protocol": 2,
    "noise": "Noise_XX_25519_ChaChaPoly_SHA256",
    "prologue": "styr-noise-v1",
    "hello": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "hello"
        },
        "protocol": {
          "type": "number",
          "const": 2
        },
        "noise": {
          "type": "string",
          "maxLength": 2048
        }
      },
      "required": [
        "type",
        "protocol",
        "noise"
      ]
    },
    "hostPayload": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "identityKey": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "signature": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      },
      "required": [
        "identityKey",
        "signature"
      ]
    },
    "devicePayload": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "auth"
            },
            "deviceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "signature": {
              "type": "string",
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            }
          },
          "required": [
            "type",
            "deviceId",
            "signature"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "pair"
            },
            "name": {
              "type": "string",
              "maxLength": 100
            },
            "identityKey": {
              "type": "string",
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            },
            "signature": {
              "type": "string",
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            },
            "proof": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "type",
            "name",
            "identityKey",
            "signature",
            "proof"
          ]
        }
      ]
    }
  },
