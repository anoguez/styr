{
  "name": "styr",
  "version": "0.39.0",
  "description": "An agentic IDE: a kanban board that dispatches AI coding agents into embedded terminals, with an MCP server so agents can drive the board",
  "main": "./out/main/index.mjs",
  "author": "Anderson Noguez",
  "homepage": "https://github.com/anoguez/styr",
  "license": "FSL-1.1-MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json && node scripts/build.mjs",
    "build:server": "vite build -c vite.server.config.mts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "yarn build && playwright test",
    "coverage:badge": "yarn test:coverage && node scripts/update-coverage-badge.mjs",
    "coverage:check": "node scripts/update-coverage-badge.mjs --check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "electron-vite preview",
    "mcp": "node ./out/main/mcp/index.mjs",
    "serve": "node ./out/server/index.mjs serve",
    "server:bundle": "node scripts/server-bundle.mjs",
    "package": "yarn build && node --env-file-if-exists=.env node_modules/electron-builder/cli.js",
    "package:adhoc": "yarn build && electron-builder -c.mac.identity=-",
    "package:win": "yarn build && electron-builder --win --x64 -c.npmRebuild=false",
    "package:linux": "yarn build && electron-builder --linux --x64",
    "postinstall": "node scripts/postinstall.mjs",
    "icon": "node scripts/make-icon.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "electron-updater": "^6.8.10",
    "gray-matter": "^4.0.3",
    "nanoid": "^6.0.2",
    "node-pty": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uqr": "^0.1.3",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/unbounded": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "electron": "^44.9.1",
    "electron-builder": "^26.17.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,html}": [
      "prettier --write"
    ]
  }
}
