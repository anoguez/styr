# Signing and notarisation for local `yarn package` and scripts/setup-signing-secrets.sh.
# Copy to .env (git-ignored) and fill in.

# Apple ID used to notarise
APPLE_ID=
# App-specific password for that Apple ID (account.apple.com → Sign-In and Security)
APPLE_APP_SPECIFIC_PASSWORD=
# Developer team id, the 10 characters in brackets after your certificate name
APPLE_TEAM_ID=

# Optional: which keychain identity to sign with, WITHOUT the "Developer ID Application: " prefix,
# e.g. "Jane Doe (ABCDE12345)". Leave unset to let electron-builder find it.
# CSC_NAME=
