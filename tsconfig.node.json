{
  "include": [
    "electron.vite.config.ts",
    "vite.server.config.mts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/core/**/*",
    "src/host/**/*",
    "src/mcp/**/*",
    "src/server/**/*",
    "src/renderer/src/lib/terminalOutput.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "paths": { "@core/*": ["./src/core/*"], "@host/*": ["./src/host/*"] }
  }
}
